5" width="60" height="30" as="geometry"/></mxCell><mxCell id="c100" value="job τ3 (execuție comandă + status)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;fontSize=13;fontColor=#000000;spacing=0;" vertex="1" parent="1"><mxGeometry x="95" y="850" width="300" height="23" as="geometry"/></mxCell><mxCell id="c101" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#1f5fa8;strokeWidth=2.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="790" as="sourcePoint"/><mxPoint x="560" y="752" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c102" value="eliberare periodică (pe grilă)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;fontSize=13;fontColor=#000000;spacing=0;" vertex="1" parent="1"><mxGeometry x="585" y="760" width="300" height="23" as="geometry"/></mxCell><mxCell id="c103" value="" style="html=1;rounded=0;endArrow=block;endFill=0;strokeColor=#1f5fa8;strokeWidth=2.5;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="830" as="sourcePoint"/><mxPoint x="560" y="800" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c104" value="eveniment acceptat → eliberare" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;fontSize=13;fontColor=#000000;spacing=0;" vertex="1" parent="1"><mxGeometry x="585" y="805" width="300" height="23" as="geometry"/></mxCell><mxCell id="c105" value="" style="html=1;rounded=0;endArrow=none;strokeColor=#c62828;strokeWidth=2.5;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="888" as="sourcePoint"/><mxPoint x="560" y="862" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c106" value="✕" style="text;html=1;align=center;verticalAlign=top;whiteSpace=nowrap;fontSize=18;fontColor=#c62828;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="545.0" y="838" width="30" height="28" as="geometry"/></mxCell><mxCell id="c107" value="eveniment respins (interval minim încălcat)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;fontSize=13;fontColor=#000000;spacing=0;" vertex="1" parent="1"><mxGeometry x="585" y="863" width="330" height="23" as="geometry"/></mxCell><mxCell id="c108" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#c62828;strokeWidth=2.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1000" y="752" as="sourcePoint"/><mxPoint x="1000" y="790" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c109" value="termen-limită absolut d = r + D" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;fontSize=13;fontColor=#000000;spacing=0;" vertex="1" parent="1"><mxGeometry x="1025" y="760" width="300" height="23" as="geometry"/></mxCell><mxCell id="c110" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#999999;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="980" y="820" as="sourcePoint"/><mxPoint x="1020" y="820" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c111" value="comunicare prin coadă / setter" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;fontSize=13;fontColor=#000000;spacing=0;" vertex="1" parent="1"><mxGeometry x="1025" y="810" width="300" height="23" as="geometry"/></mxCell><mxCell id="c112" value="Ce se vede în diagramă" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;fontSize=15;fontColor=#000000;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="923" width="400" height="25" as="geometry"/></mxCell><mxCell id="c113" value="• τ1 este eliberat pe grila r_k = r_0 + k·T; perioada nu derivă, deoarece se așteaptă absolut până la următoarea eliberare." style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;fontSize=13;fontColor=#000000;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="953" width="1450" height="23" as="geometry"/></mxCell><mxCell id="c114" value="• La t = 2 temperatura depășește pragul: τ1 pune un eveniment în coadă, iar τ2 publică alarma (prima eliberare a lui τ2)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;fontSize=13;fontColor=#000000;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="977" width="1450" height="23" as="geometry"/></mxCell><mxCell id="c115" value="• La t = 6 un nou eveniment este respins: au trecut doar 4 s de la eliberarea precedentă a lui τ2 (minim 5 s)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;fontSize=13;fontColor=#000000;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="1001" width="1450" height="23" as="geometry"/></mxCell><mxCell id="c116" value="• La t = 5 sosește comanda SET_INTERVAL 1000; τ3 o execută imediat. Noua perioadă se aplică după jobul de la t = 6, deci eliberările devin 7, 8, 9, 10." style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;fontSize=13;fontColor=#000000;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="1025" width="1450" height="23" as="geometry"/></mxCell><mxCell id="c117" value="• La t = 7 evenimentul este acceptat (7 − 2 = 5 s). Thread-urile Java rulează în paralel (mai multe nuclee), deci nu apar preempțiuni sau timp în Ready." style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;fontSize=13;fontColor=#000000;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="1049" width="1450" height="23" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>